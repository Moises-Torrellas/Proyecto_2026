# Ignorar dependencias de Composer
/vendor/

# Ignorar archivos dentro de la carpeta logs
/logs/*
# Excepto el archivo .gitkeep (si quieres mantener la carpeta vacía en GitHub)
!/logs/.gitkeep
#Ignorar archivos dentro de la carpeta backups
/backups/*
/reporte_cobertura/*
# Excepto el archivo.gitkeep
!/backups/.gitkeep

/storage/*

.env
.env.local
.env.testing
datos_prueba_postman.csv
exposicion_postman.md
Presentacion_Postman.pptx
analisis-seguridad-login.md
.phpunit.result.cache
/coverage


/public/img/usuarios/*
/public/img/atletas/*
/public/docs/reportes/*
/storage/*
# Otros archivos recomendados para tu entorno (XAMPP/Windows)
.DS_Store
Thumbs.db
.vscode/
*.lnk
*test.sql

# Resultados temporales de pruebas de rendimiento (JMeter)
/tests/Performance/resultados/*
!/tests/Performance/resultados/.gitkeep
jmeter.log