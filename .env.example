; =============================================================================
; PLANTILLA DE CONFIGURACIÓN DE ENTORNO (.env.example)
; Copia este archivo como .env y ajusta los valores para tu entorno local o CI/CD.
; Nota: Usa ';' para comentarios porque config/config.php usa parse_ini_file().
; =============================================================================

; Google reCAPTCHA v2 / v3
RECAPTCHA_SITE_KEY=tu_recaptcha_site_key_aqui
RECAPTCHA_SECRET_KEY=tu_recaptcha_secret_key_aqui
RECAPTCHA_ACTIVO=false

; Tasa de Cambio (ExchangeRate-API)
EXCHANGE_RATE_API_KEY=tu_exchange_rate_api_key_aqui

; Servicio de Correo SMTP (PHPMailer / Gmail)
PASS_EMAIL=tu_contraseña_aplicacion_aqui
EMAIL_R=soporte@ejemplo.com
EMAIL_RE=soporte@ejemplo.com

; Base de Datos: Sistema General (SG / Seguridad y Usuarios)
DB_NAME_SG=bds2
DB_HOST_SG=127.0.0.1
DB_USER_SG=root
DB_PASS_SG=root

; Base de Datos Principal: Cannibals Lara (Operacional)
DB_NAME=cannibalsbd2
DB_HOST=127.0.0.1
DB_USER=root
DB_PASS=root

; IA / Gemini API
GEMINI_API_KEY=tu_api_key_gemini_aqui
