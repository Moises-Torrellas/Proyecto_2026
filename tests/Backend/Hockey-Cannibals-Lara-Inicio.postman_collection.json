          "script": {
            "type": "text/javascript",
            "exec": [
              "const html = pm.response.text();\r\nconst match = html.match(/<meta\\s+name=[\"']csrf-token[\"']\\s+content=[\"']([^\"']+)[\"']/i);\r\nif (match && match[1]) {\r\n    pm.environment.set(\"csrf_token\", match[1]);\r\n    console.log(\"CSRF Token actualizado automáticamente:\", match[1]);\r\n}"
            ]
          }
        }
