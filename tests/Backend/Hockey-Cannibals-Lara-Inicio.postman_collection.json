    "event": [
        {
            "listen": "prerequest",
            "script": {
                "exec": [
                    "// Los controladores exigen petición AJAX y token CSRF en la cabecera\r",
                    "if (pm.request.method !== \"GET\") {\r",
                    "    pm.request.headers.upsert({ key: \"X-Requested-With\", value: \"XMLHttpRequest\" });\r",
                    "    pm.request.headers.upsert({ key: \"X-CSRF-Token\", value: pm.environment.get(\"csrf_token\") || \"\" });\r",
                    "}"
                ],
                "type": "text/javascript"
            }
        }
