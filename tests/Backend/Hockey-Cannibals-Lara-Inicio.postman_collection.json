    "item": [
        {
            "name": "InicioModulo",
            "item": [
                {
                    "name": "GET Cargar-Vista-Inicio",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test(\"Estado HTTP es 200\", function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "const html = pm.response.text();",
                                    "const match = html.match(/<meta\\s+name=[\"']csrf-token[\"']\\s+content=[\"']([^\"']+)[\"']/i) ||",
                                    "            html.match(/<meta\\s+content=[\"']([^\"']+)[\"']\\s+name=[\"']csrf-token[\"']/i);",
                                    "if (match && match[1]) {",
                                    "    pm.environment.set(\"csrf_token\", match[1]);",
                                    "    console.log(\"CSRF Token inicial extraído exitosamente:\", match[1]);",
                                    "}"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{url_base}}",
                            "host": [
                                "{{url_base}}"
                            ]
                        },
                        "description": "Carga la vista de inicio/login para obtener cookies de sesión y el token CSRF inicial."
                    },
                    "response": []
                }
            ]
        },
