            <stringProp name="RegexExtractor.regex">&lt;meta\s+name=[&quot;&apos;]csrf-token[&quot;&apos;]\s+content=[&quot;&apos;]([^&quot;&apos;]+)[&quot;&apos;]</stringProp>
